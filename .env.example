# Copy this file to .env and fill in the two blocks below. Never commit .env.

# --- PayPal sandbox -----------------------------------------------------------
# developer.paypal.com > Apps & Credentials > Sandbox > Create App
# Use an app that belongs to a US sandbox business account (Payouts is not offered in every country).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# --- AI model (any OpenAI-compatible endpoint) ----------------------------------
# Default: Google Gemini, free key from https://aistudio.google.com/apikey
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=
LLM_MODEL=gemini-flash-latest
# Other options:
#   Groq    LLM_BASE_URL=https://api.groq.com/openai/v1      LLM_MODEL=<a tool-calling model from console.groq.com>
#   OpenAI  LLM_BASE_URL=https://api.openai.com/v1           LLM_MODEL=<a current GPT model>
#   Ollama  LLM_BASE_URL=http://localhost:11434/v1           LLM_API_KEY=ollama  LLM_MODEL=<a local tool-calling model>

# --- Demo data (optional) ---------------------------------------------------------
# Put your own sandbox account emails here to see the money arrive in the sandbox.
# developer.paypal.com > Testing Tools > Sandbox Accounts
# DEMO_CONTRACTOR_EMAIL=   a sandbox personal account (receives the payout)
# DEMO_CONTRACTOR2_EMAIL=  another sandbox personal account, or any email
# DEMO_CLIENT_EMAIL=       any email (receives the invoice)
# DEMO_VENDOR_EMAIL=       a second sandbox business account (receives the purchase)
# BUSINESS_NAME=Kestrel Studio

# --- Server (optional) ---------------------------------------------------------------
# PUBLIC_BASE_URL=http://localhost:8000   where PayPal sends the owner back after approving a purchase
# COUNTERSIGN_DB=countersign.db
# COUNTERSIGN_OFFLINE_PREVIEW=1           explore the interface with stand-ins, no keys, no real calls
